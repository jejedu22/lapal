# Copier en .env.docker puis lancer :
#   docker compose --env-file .env.docker up -d --build

# Nom de domaine servi par Traefik (DNS -> serveur)
LAPAL_HOST=lapal.example.org

# Symfony : générer avec  openssl rand -hex 32
APP_SECRET=change-me

# Base de données
DB_NAME=lapal
DB_USER=lapal
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

# Jouer les migrations Doctrine au démarrage du conteneur (1/0)
RUN_MIGRATIONS=1
