<form method="post" action="{{ path('user_delete', {'id': user.id}) }}" class="d-inline"
      onsubmit="return confirm('Supprimer le compte {{ user.username|e('js') }} ?');">
    <input type="hidden" name="_method" value="DELETE">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user.id) }}">
    <button class="btn btn-outline-danger btn-sm"><i class="fas fa-trash-alt" aria-hidden="true"></i> Supprimer</button>
</form>
