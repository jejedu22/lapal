{% extends 'base.html.twig' %}

{% block title %}{{ user.username }}{% endblock %}

{% block titre_page %}
    <h1 class="h3 text-dark mb-0">{{ user.username }}</h1>
{% endblock %}

{% block body %}
<div class="col-12 col-lg-8 col-xl-6">
    <div class="card">
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-4">Identifiant</dt>
                <dd class="col-sm-8">{{ user.username }}</dd>
            </dl>
        </div>
        <div class="card-footer">
            <a href="{{ path('user_index') }}" class="btn btn-link pl-0"><i class="fas fa-arrow-left" aria-hidden="true"></i> Retour</a>
            <div class="float-right">{{ include('user/_delete_form.html.twig') }}</div>
        </div>
    </div>
</div>
{% endblock %}
