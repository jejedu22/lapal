{% set route = app.request.attributes.get('_route') %}
{% set route_params = app.request.attributes.get('_route_params') ?? {} %}
{% set couleur = options_settings.get('color', 'orange') %}
{% set nom_appli = options_settings.get('name', 'Lapal') %}
{% set logo = options_settings.get('logo') %}
<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}{{ nom_appli }}{% endblock %} · {{ nom_appli }}</title>

        <link rel="stylesheet" href="{{ asset('plugins/fontawesome/css/all.min.css') }}">
        <link rel="stylesheet" href="{{ asset('fonts/source-sans-pro.css') }}">
        <link rel="stylesheet" href="{{ asset('dist/css/adminlte.min.css') }}">
        <link rel="stylesheet" href="{{ asset('plugins/jquery-ui/jquery-ui.min.css') }}">
        <link rel="stylesheet" href="{{ asset('plugins/datepicker/datepicker3.css') }}">
        <link rel="stylesheet" href="{{ asset('dist/css/style.css') }}">
        {% block stylesheets %}{% endblock %}

        {# Installation sur l'écran d'accueil des téléphones #}
        <link rel="manifest" href="{{ path('app_manifest') }}">
        <meta name="theme-color" content="{{ couleur_hex(couleur) }}">
        {% if logo %}
            <link rel="icon" type="image/png" href="{{ asset('uploads/logo/' ~ logo) }}">
            <link rel="apple-touch-icon" href="{{ asset('uploads/logo/' ~ logo) }}">
        {% endif %}
        <meta name="apple-mobile-web-app-capable" content="yes">
        <meta name="apple-mobile-web-app-title" content="{{ nom_appli }}">
    </head>
    <body class="hold-transition sidebar-mini layout-fixed">
        <div class="wrapper">

            <nav class="main-header navbar navbar-expand navbar-dark navbar-{{ couleur }}">
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <a class="nav-link" data-widget="pushmenu" href="#" role="button" aria-label="Afficher / masquer le menu"><i class="fas fa-bars" aria-hidden="true"></i></a>
                    </li>
                    {% block navbar %}{% endblock %}
                </ul>

                <ul class="navbar-nav ml-auto">
                    {% if options_settings.get('contact_email') %}
                        <li class="nav-item" title="Nous écrire">
                            {{ options_settings.getObfuscatedEmailLink(options_settings.get('contact_email'), {'aria-label': 'Nous écrire'}) | raw }}
                        </li>
                    {% endif %}
                </ul>
            </nav>

            {% macro lien(label, icone, url, actif) %}
                <li class="nav-item">
                    <a href="{{ url }}" class="nav-link{{ actif ? ' active' }}"{{ actif ? ' aria-current="page"' }}>
                        <i class="nav-icon {{ icone }}" aria-hidden="true"></i>
                        <p>{{ label }}</p>
                    </a>
                </li>
            {% endmacro %}
            {% import _self as menu %}

            <aside class="main-sidebar elevation-4 sidebar-dark-{{ couleur }}">
                <a href="{{ path('passe_commande_index') }}" class="brand-link navbar-{{ couleur }}">
                    {% if logo %}
                        <img src="{{ asset('uploads/logo/' ~ logo) }}" alt="" class="brand-image img-circle elevation-3">
                    {% endif %}
                    <span class="brand-text font-weight-light">{{ nom_appli }}</span>
                </a>

                <div class="sidebar">
                    <nav class="mt-2" aria-label="Menu principal">
                        <ul class="nav nav-pills nav-sidebar flex-column nav-child-indent" data-widget="treeview" role="menu" data-accordion="false">
                            {{ menu.lien('Passer commande', 'fas fa-shopping-basket', path('passe_commande_index'), route in ['passe_commande_index', 'passe_commande_new']) }}
                            {% if app.request.cookies.has('commande') %}
                                {{ menu.lien('Ma commande', 'fas fa-receipt', path('commande_index'), route in ['commande_index', 'commande_edit']) }}
                            {% endif %}
                            {{ menu.lien('Commandes à venir', 'fas fa-list-ul', path('synthese_index', {'suivi': 0}), route == 'synthese_index' and route_params.suivi == 0) }}

                            {% if is_granted('ROLE_USER') %}
                                <li class="nav-header">DISTRIBUTION</li>
                                {{ menu.lien('Suivi des livraisons', 'fas fa-check-double', path('synthese_index', {'suivi': 1}), route == 'synthese_index' and route_params.suivi == 1) }}
                                {{ menu.lien('Toutes les commandes', 'fas fa-archive', path('synthese_index', {'suivi': 2}), route == 'synthese_index' and route_params.suivi == 2) }}
                                {{ menu.lien('Synthèse des poids', 'fas fa-balance-scale', path('synthese_poids'), route == 'synthese_poids') }}

                                <li class="nav-header">ADMINISTRATION</li>
                                {{ menu.lien('Jours de distribution', 'far fa-calendar-alt', path('jour_distrib_index'), route starts with 'jour_distrib') }}
                                {{ menu.lien('Pains', 'fas fa-bread-slice', path('pain_index'), route starts with 'pain_') }}
                                {{ menu.lien('Boulangers', 'fas fa-user-tie', path('boulanger_index'), route starts with 'boulanger') }}
                                {{ menu.lien('Configuration', 'fas fa-cogs', path('settings_index'), route starts with 'settings') }}
                                {{ menu.lien('Utilisateurs', 'fas fa-users', path('user_index'), route starts with 'user_' or route == 'app_register') }}

                                <li class="nav-header">{{ app.user.username|upper }}</li>
                                {{ menu.lien('Déconnexion', 'fas fa-sign-out-alt', path('app_logout'), false) }}
                            {% else %}
                                <li class="nav-header">ÉQUIPE</li>
                                {{ menu.lien('Connexion', 'fas fa-key', path('app_login'), route == 'app_login') }}
                            {% endif %}
                        </ul>
                    </nav>
                </div>
            </aside>

            <div class="content-wrapper">
                <div class="content-header">
                    <div class="container-fluid">
                        {% block titre_page %}
                            <h1 class="titre-accueil text-dark">{{ options_settings.get('welcome_text')|raw }}</h1>
                        {% endblock %}
                    </div>
                </div>

                <div class="content">
                    {% block modal %}{% endblock %}
                    <div class="container-fluid">
                        {% set titres_flash = {
                            'success': ['C’est enregistré !', 'fas fa-check-circle'],
                            'warning': ['Attention', 'fas fa-exclamation-triangle'],
                            'danger':  ['Erreur', 'fas fa-times-circle'],
                            'info':    ['Information', 'fas fa-info-circle'],
                        } %}
                        {% for label, messages in app.flashes %}
                            {% for message in messages %}
                                {% set titre = titres_flash[label] ?? ['Information', 'fas fa-info-circle'] %}
                                <div class="alert alert-{{ label }} alert-dismissible" role="alert">
                                    <button type="button" class="close" data-dismiss="alert" aria-label="Fermer">×</button>
                                    <h5><i class="icon {{ titre[1] }}" aria-hidden="true"></i> {{ titre[0] }}</h5>
                                    {{ message }}
                                </div>
                            {% endfor %}
                        {% endfor %}

                        <div class="row">
                            {% block body %}{% endblock %}
                        </div>
                    </div>
                </div>
            </div>

            <footer class="main-footer text-sm text-muted">
                {{ nom_appli }}
            </footer>
        </div>

        <script src="{{ asset('plugins/jquery/jquery.min.js') }}"></script>
        <script src="{{ asset('plugins/jquery-ui/jquery-ui.min.js') }}"></script>
        <script src="{{ asset('plugins/bootstrap/js/bootstrap.bundle.min.js') }}"></script>
        <script src="{{ asset('dist/js/adminlte.min.js') }}"></script>
        <script src="{{ asset('plugins/moment/min/moment-with-locales.min.js') }}"></script>
        <script src="{{ asset('plugins/datepicker/bootstrap-datepicker.js') }}"></script>
        {% block javascripts %}{% endblock %}
    </body>
</html>
