{{ form_start(form) }}
    {% if form.vars.data.name == 'color' %}
        <fieldset>
            <legend class="col-form-label">Choisissez la couleur de l’en-tête et du menu</legend>
            <div class="nuancier">
                {% for choix in form.value %}
                    <div class="nuancier__choix">
                        <input type="radio" class="nuancier__radio" id="{{ choix.vars.id }}" name="{{ choix.vars.full_name }}"
                               value="{{ choix.vars.value }}"{{ choix.vars.checked ? ' checked' }}>
                        <label for="{{ choix.vars.id }}" class="nuancier__pastille color-{{ choix.vars.value }}" title="{{ choix.vars.label }}">
                            <span class="sr-only">{{ choix.vars.label }}</span>
                        </label>
                    </div>
                    {% do choix.setRendered %}
                {% endfor %}
            </div>
        </fieldset>
        {% do form.value.setRendered %}
    {% elseif form.vars.data.name == 'logo' %}
        {% if options_settings.get('logo') %}
            <div class="text-center mb-3">
                <img src="{{ asset('uploads/logo/' ~ options_settings.get('logo')) }}" alt="Logo actuel"
                     class="img-circle elevation-2 navbar-{{ options_settings.get('color') }}" style="max-height: 80px">
            </div>
        {% endif %}
        {{ form_row(form.value, {
            'label': 'Nouveau logo (PNG, 100 Ko maximum)',
            'attr': {'placeholder': 'Choisir une image PNG', 'accept': 'image/png'}
        }) }}
    {% elseif form.vars.data.name == 'welcome_text' %}
        {{ form_row(form.value, {'label': 'Texte affiché en haut de la page d’accueil', 'help': 'Le HTML simple est accepté, par exemple <b>gras</b>.'}) }}
    {% else %}
        {{ form_row(form.value, {'label': false}) }}
    {% endif %}
    {{ form_rest(form) }}
    <button class="btn btn-success">{{ button_label|default('Enregistrer') }}</button>
    <a href="{{ path('settings_index') }}" class="btn btn-link">Annuler</a>
{{ form_end(form) }}
