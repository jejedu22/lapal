{% extends 'base.html.twig' %}

{% block title %}Boulangers{% endblock %}

{% block titre_page %}
    <h1 class="h3 text-dark mb-0">Boulangers</h1>
{% endblock %}

{% block navbar %}
    <li class="nav-item d-none d-sm-inline-block">
        <a href="{{ path('boulanger_new') }}" class="nav-link">Ajouter un boulanger</a>
    </li>
{% endblock %}

{% block body %}
<div class="col-12 col-lg-8 col-xl-6">
    <div class="card">
        <div class="card-header">
            <h2 class="card-title">{{ boulangers|length }} boulanger{{ boulangers|length > 1 ? 's' }}</h2>
            <div class="card-tools">
                <a href="{{ path('boulanger_new') }}" class="btn btn-success btn-sm"><i class="fas fa-plus" aria-hidden="true"></i> Ajouter</a>
            </div>
        </div>
        <ul class="list-group list-group-flush">
            {% for boulanger in boulangers %}
                <li class="list-group-item">
                    <a href="{{ path('boulanger_edit', {'id': boulanger.id}) }}"><i class="fas fa-user-tie text-muted mr-2" aria-hidden="true"></i>{{ boulanger.prenom }} {{ boulanger.nom }}</a>
                </li>
            {% else %}
                <li class="list-group-item text-muted">Aucun boulanger. <a href="{{ path('boulanger_new') }}">Ajouter le premier</a></li>
            {% endfor %}
        </ul>
    </div>
</div>
{% endblock %}
