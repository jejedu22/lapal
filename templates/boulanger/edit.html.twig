{% extends 'base.html.twig' %}

{% block title %}Modifier un boulanger{% endblock %}

{% block titre_page %}
    <h1 class="h3 text-dark mb-0">{{ boulanger.prenom }} {{ boulanger.nom }}</h1>
{% endblock %}

{% block body %}
    <div class="col-12 col-lg-8 col-xl-6">
        <div class="card">
            <div class="card-header">
                <h2 class="card-title">Modifier</h2>
                <div class="card-tools">
                    {{ include('boulanger/_delete_form.html.twig') }}
                </div>
            </div>
            <div class="card-body">
                {{ include('boulanger/_form.html.twig') }}
            </div>
        </div>
    </div>
{% endblock %}
