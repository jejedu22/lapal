<form method="post" action="{{ path('boulanger_delete', {'id': boulanger.id}) }}" class="d-inline"
      onsubmit="return confirm('Supprimer ce boulanger ?');">
    <input type="hidden" name="_method" value="DELETE">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ boulanger.id) }}">
    <button class="btn btn-outline-danger btn-sm"><i class="fas fa-trash-alt" aria-hidden="true"></i> Supprimer</button>
</form>
