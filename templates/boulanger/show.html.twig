{% extends 'base.html.twig' %}

{% block title %}{{ boulanger.prenom }} {{ boulanger.nom }}{% endblock %}

{% block titre_page %}
    <h1 class="h3 text-dark mb-0">{{ boulanger.prenom }} {{ boulanger.nom }}</h1>
{% endblock %}

{% block body %}
    <div class="col-12 col-lg-8 col-xl-6">
        <div class="card">
            <div class="card-footer">
                <a href="{{ path('boulanger_index') }}" class="btn btn-link pl-0"><i class="fas fa-arrow-left" aria-hidden="true"></i> Retour</a>
                <a href="{{ path('boulanger_edit', {'id': boulanger.id}) }}" class="btn btn-outline-primary btn-sm"><i class="fas fa-pen" aria-hidden="true"></i> Modifier</a>
                <div class="float-right">{{ include('boulanger/_delete_form.html.twig') }}</div>
            </div>
        </div>
    </div>
{% endblock %}
