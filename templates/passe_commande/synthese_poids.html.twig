{% extends 'base.html.twig' %}

{% block title %}Synthèse des poids{% endblock %}

{% block titre_page %}
    <h1 class="h3 text-dark mb-0">Synthèse des poids</h1>
    <p class="text-muted mb-0">Quantités à préparer par pain et par jour de distribution.</p>
{% endblock %}

{% block body %}
<div class="col-12 col-xl-10">
    <div class="text-right mb-2 no-print">
        <button type="button" class="btn btn-outline-secondary btn-sm" onclick="window.print()"><i class="fas fa-print" aria-hidden="true"></i> Imprimer</button>
    </div>
    {% for jour in jours %}
        {% set lignes = quantites[jour.id] ?? [] %}
        {% set a_venir = not jour.passe %}
        <div class="card{{ a_venir ? '' : ' collapsed-card' }}">
            <div class="card-header">
                <h2 class="card-title">
                    {{ jour.date|format_datetime('full', 'none', locale='fr')|capitalize }}
                    {% if jour.boulanger %}<small class="text-muted ml-1">{{ jour.boulanger.prenom }} {{ jour.boulanger.nom }}</small>{% endif %}
                </h2>
                <div class="card-tools">
                    <a href="{{ path('jour_distrib_bon', {'id': jour.id}) }}" class="btn btn-tool" title="Bon de préparation"><i class="fas fa-print" aria-hidden="true"></i><span class="sr-only">Bon de préparation</span></a>
                    <button type="button" class="btn btn-tool" data-card-widget="collapse" aria-label="Replier / déplier">
                        <i class="fas {{ a_venir ? 'fa-minus' : 'fa-plus' }}" aria-hidden="true"></i>
                    </button>
                </div>
            </div>
            <div class="card-body p-0">
                {% if lignes is empty %}
                    <p class="text-muted m-3">Aucune commande pour ce jour.</p>
                {% else %}
                    {{ include('passe_commande/_tableau_poids.html.twig', {'lignes': lignes, 'jour': jour}) }}
                {% endif %}
            </div>
        </div>
    {% else %}
        <div class="callout callout-info"><p class="mb-0">Aucun jour de distribution.</p></div>
    {% endfor %}
</div>
{% endblock %}
