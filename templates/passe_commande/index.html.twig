{% extends 'base.html.twig' %}

{% block title %}Passer commande{% endblock %}

{% block body %}
{% set statuts = {
    'ferme':      ['Commandes fermées', 'secondary'],
    'complet':    ['Complet', 'warning'],
    'aujourdhui': ['Distribution aujourd’hui – commandes closes', 'info'],
} %}
<div class="col-12">
    <h2 class="h5 mb-3">Choisissez un jour de distribution</h2>
</div>

{% for jour in jour_distribs %}
    {% set statut = jour.statut %}
    <div class="col-12 col-md-6 col-xl-4 d-flex">
        <div class="card carte-jour flex-fill{{ statut != 'ouvert' ? ' carte-jour--indisponible' }}">
            <div class="card-body">
                <div class="d-flex align-items-start">
                    <div class="date-bloc mr-3" aria-hidden="true">
                        <span class="date-bloc__jour">{{ jour.date|format_datetime(pattern='d', locale='fr') }}</span>
                        <span class="date-bloc__mois">{{ jour.date|format_datetime(pattern='MMM', locale='fr')|trim('.') }}</span>
                    </div>
                    <div class="flex-fill">
                        <h3 class="h5 mb-1">{{ jour.date|format_datetime('full', 'none', locale='fr')|capitalize }}</h3>
                        {% if jour.boulanger %}
                            <div class="text-muted"><i class="fas fa-user-tie" aria-hidden="true"></i> {{ jour.boulanger.prenom }} {{ jour.boulanger.nom }}</div>
                        {% endif %}
                        {% if jour.commentaire %}
                            <div class="text-muted"><i class="fas fa-map-marker-alt" aria-hidden="true"></i> {{ jour.commentaire }}</div>
                        {% endif %}
                    </div>
                </div>

                {% if statut == 'ouvert' %}
                    <div class="mt-3">
                        <div class="d-flex justify-content-between small">
                            <span>Reste <strong>{{ jour.poidsDisponible|kg }}</strong></span>
                            <span class="text-muted">sur {{ jour.total|kg }}</span>
                        </div>
                        <div class="progress progress-sm mt-1" role="progressbar" aria-label="Fournée déjà commandée"
                             aria-valuenow="{{ jour.tauxRemplissage }}" aria-valuemin="0" aria-valuemax="100">
                            <div class="progress-bar {{ jour.tauxRemplissage >= 80 ? 'bg-warning' : 'bg-success' }}" style="width: {{ jour.tauxRemplissage }}%"></div>
                        </div>
                    </div>
                    <a href="{{ path('passe_commande_new', {'idJourDistrib': jour.id}) }}" class="btn btn-success btn-block btn-lg mt-3">
                        <i class="fas fa-shopping-basket" aria-hidden="true"></i> Commander
                    </a>
                {% else %}
                    <div class="mt-3">
                        <span class="badge badge-{{ statuts[statut][1] }} badge-statut">{{ statuts[statut][0] }}</span>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
{% else %}
    <div class="col-12">
        <div class="callout callout-warning">
            <h5>Pas de distribution prévue pour l’instant</h5>
            <p class="mb-0">Revenez bientôt : les prochains jours de distribution apparaîtront ici.</p>
        </div>
    </div>
{% endfor %}
{% endblock %}
