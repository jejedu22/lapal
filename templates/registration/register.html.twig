{% extends 'base.html.twig' %}

{% block title %}Nouvel utilisateur{% endblock %}

{% block titre_page %}
    <h1 class="h3 text-dark mb-0">Nouvel utilisateur</h1>
{% endblock %}

{% block body %}
<div class="col-12 col-sm-8 col-md-6 col-lg-5">
    <div class="card">
        <div class="card-body">
            {{ form_start(registrationForm) }}
                {{ form_row(registrationForm.username) }}
                {{ form_row(registrationForm.plainPassword) }}
                {{ form_row(registrationForm.agreeTerms) }}
                <button type="submit" class="btn btn-success">Créer le compte</button>
                <a href="{{ path('user_index') }}" class="btn btn-link">Annuler</a>
            {{ form_end(registrationForm) }}
        </div>
    </div>
</div>
{% endblock %}
